# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Postgres (docker compose service `db`, or any local instance)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/crm-aluinter

# Signs session cookies. Changing this logs everyone out.
# Middleware inlines this at build time — keep it stable locally.
AUTH_SECRET=crm-aluinter-local-dev-secret

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED
# ============================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3004
NEXT_PUBLIC_APP_LOCALE=pt

# Local media uploads (avatars, chat-media, flow-media)
STORAGE_DIR=./data/storage

# ============================================================
# OPTIONAL
# ============================================================

# ALLOWED_INVITE_HOSTS=crm.example.com
# AUTOMATION_CRON_SECRET=generate-a-long-random-string
# META_APP_ID=your-meta-app-id
# WHATSAPP_TEMPLATES_DRY_RUN=true
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
