# Copy to .env.docker.local for Docker Compose (app container only).
# Supabase still runs on the host via `npm run supabase:start`.
#
#   cp .env.docker.local.example .env.docker.local
#   # fill ENCRYPTION_KEY and keys like .env.local
#
# Inside the container, 127.0.0.1 is the app — use host.docker.internal.

