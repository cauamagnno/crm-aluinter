# Copy to .env.docker.local:
#   cp .env.docker.local.example .env.docker.local
#
# Then:
#   npm run docker:up

POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
HOST_PORT=3004
SEED_DEMO=1

DATABASE_URL=postgres://postgres:postgres@db:5432/crm-aluinter
AUTH_SECRET=crm-aluinter-local-dev-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
META_APP_SECRET=local-dev-meta-app-secret-not-used
NEXT_PUBLIC_SITE_URL=http://localhost:3004
NEXT_PUBLIC_APP_LOCALE=pt
WHATSAPP_TEMPLATES_DRY_RUN=true
STORAGE_DIR=/tmp/crm-aluinter-storage
